# Copy to control-plane.env and load before starting the Node control plane.
# Never commit the real file. Full walkthrough: docs/INSTALL.md

# --- core ---
OC_HTTP_ADDR=:8080
# URL browsers AND agents use to reach this panel.
# localhost is fine for same-machine only. Remote game hosts need a LAN/public hostname or IP.
OC_PUBLIC_URL=http://localhost:8080
# true = local/dev (installer default). Set false when exposing beyond a trusted machine.
OC_DEV_MODE=true
OC_WEB_ORIGIN=http://localhost:8080
OC_WEB_DIR=../web/dist

# --- database (SQLite) ---
OC_DATABASE_URL=../deploy/OpsCenter.sqlite

# --- agent gateway (C# agents dial this; panel must accept inbound) ---
OC_AGENT_ADDR=:8443

# --- sessions ---
OC_SESSION_TTL_HOURS=12

# --- Owner bootstrap (OAuth allowlist) ---
# Comma-separated provider:subject. First matching login becomes Owner (and stays break-glass).
# Without this, every account stays pending and nobody can approve anyone.
# Discord: enable Developer Mode → right-click your user → Copy User ID
# Steam: 64-bit SteamID
# Example:
# OC_BOOTSTRAP_OWNERS=discord:123456789012345678,steam:76561198000000000
OC_BOOTSTRAP_OWNERS=

# --- OAuth (optional / legacy) ---
# Prefer Admin → Sign-in (encrypted in DB). The Windows installer writes
# deploy/oauth-bootstrap.json once; the panel imports it on first start.
# Env vars below still work as a fallback for Docker/advanced setups.
# Create an app at the provider, then register redirect:
#   {OC_PUBLIC_URL}/api/auth/oauth/{provider}/callback
# OC_OAUTH_DISCORD_CLIENT_ID=
# OC_OAUTH_DISCORD_CLIENT_SECRET=
# OC_OAUTH_GOOGLE_CLIENT_ID=
# OC_OAUTH_GOOGLE_CLIENT_SECRET=
# OC_OAUTH_MICROSOFT_CLIENT_ID=
# OC_OAUTH_MICROSOFT_CLIENT_SECRET=
# OC_OAUTH_MICROSOFT_TENANT=common
# OC_OAUTH_STEAM=1
# Optional fallback Steam Web API key (workshop titles/deps). Prefer Admin → Steam in the panel.
# OC_OAUTH_STEAM_API_KEY=
# OC_OAUTH_EPIC_CLIENT_ID=
# OC_OAUTH_EPIC_CLIENT_SECRET=
# Optional path override for one-shot OAuth bootstrap JSON:
# OC_OAUTH_BOOTSTRAP_FILE=

# --- secrets at rest (Steam passwords in SQLite) ---
# OC_SECRETS_KEY=
# OC_SECRETS_KEY_FILE=

# --- optional: folder containing opscenter-agent.exe (default: agent-csharp/publish) ---
# OC_AGENT_DIST_DIR=
