# Copy to control-plane.env and load before starting the Node control plane.
# Never commit the real file.

# --- core ---
A3P_HTTP_ADDR=:8080
A3P_PUBLIC_URL=http://localhost:8080
A3P_DEV_MODE=true
A3P_WEB_ORIGIN=http://localhost:8080
A3P_WEB_DIR=../web/dist

# --- database (SQLite) ---
A3P_DATABASE_URL=../deploy/a3panel.sqlite

# --- agent gateway (C# agents dial this) ---
A3P_AGENT_ADDR=:8443

# --- sessions ---
A3P_SESSION_TTL_HOURS=12

# --- Owner bootstrap (OAuth allowlist) ---
# Comma-separated provider:subject. First matching login becomes Owner (and stays break-glass).
# Discord: enable Developer Mode → right-click your user → Copy User ID
# Steam: 64-bit SteamID
# Example:
# A3P_BOOTSTRAP_OWNERS=discord:123456789012345678,steam:76561198000000000
A3P_BOOTSTRAP_OWNERS=

# --- OAuth providers (leave blank to hide) ---
# Redirect URI for each: {A3P_PUBLIC_URL}/api/auth/oauth/{provider}/callback
# A3P_OAUTH_DISCORD_CLIENT_ID=
# A3P_OAUTH_DISCORD_CLIENT_SECRET=
# A3P_OAUTH_GOOGLE_CLIENT_ID=
# A3P_OAUTH_GOOGLE_CLIENT_SECRET=
# A3P_OAUTH_MICROSOFT_CLIENT_ID=
# A3P_OAUTH_MICROSOFT_CLIENT_SECRET=
# A3P_OAUTH_MICROSOFT_TENANT=common
# A3P_OAUTH_STEAM=1
# A3P_OAUTH_STEAM_API_KEY=   # optional — enriches Steam display name
# A3P_OAUTH_EPIC_CLIENT_ID=
# A3P_OAUTH_EPIC_CLIENT_SECRET=

# --- secrets at rest (SteamCMD passwords in SQLite) ---
# A3P_SECRETS_KEY=
# A3P_SECRETS_KEY_FILE=
